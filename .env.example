# Copy to .env and fill in. Format: KEY=value, no quotes, no spaces around "=".
# Generate a secret key: python3 -c "import secrets; print(secrets.token_urlsafe(50))"

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Keycloak ---
# Address users/clients reach Keycloak at. Use the server's IP or domain when deploying.
KEYCLOAK_PUBLIC_URL=http://localhost:8080
# Must equal KEYCLOAK_PUBLIC_URL + /realms/gradian
KEYCLOAK_ISSUER=http://localhost:8080/realms/gradian
# Optional; defaults to KEYCLOAK_ISSUER + /protocol/openid-connect/certs (docker-compose overrides it)
# KEYCLOAK_JWKS_URL=
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
# Password of the 4 seeded dev users in keycloak/gradian-realm.json
DEV_USER_PASSWORD=change-me

# --- Ports / hosts ---
KEYCLOAK_PORT=8080
BACKEND_PORT=8000
# Where the core reaches team services ({n} = team number, {port} = its port). docker-compose overrides it.
TEAM_URL=http://localhost:{port}
