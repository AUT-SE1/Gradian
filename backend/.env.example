# Copy to .env (`make env` does this and fills in fresh secrets) and fill in.
# Format: KEY=value, no quotes, no spaces around "=".

# Django
# development, test or production. Production refuses demo data and the test client.
ENVIRONMENT=development
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO
# File loaded at startup. Defaults to the .env at the repository root.
# DOTENV_FILE=

# Database (PostgreSQL)
POSTGRES_DB=gradian
POSTGRES_USER=gradian
POSTGRES_PASSWORD=change-me
# docker-compose overrides the host to "db" for the core container.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Keycloak
# Must equal KEYCLOAK_URL + /realms/<realm>. This is the `iss` claim of every token.
KEYCLOAK_ISSUER=http://keycloak:8080/realms/gradian
KEYCLOAK_REALM=gradian
# How the core reaches Keycloak. Defaults to the issuer's base URL.
# docker-compose sets it to http://keycloak:8080.
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_WEB_CLIENT_ID=gradian-web
# Tokens must carry this audience. The same client's service account calls the Admin API.
KEYCLOAK_CORE_CLIENT_ID=gradian-core
KEYCLOAK_CORE_CLIENT_SECRET=change-me
KEYCLOAK_TIMEOUT_SECONDS=5
# Keycloak's bootstrap admin, for the console at KEYCLOAK_URL.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Seed data
# Password of every demo user (make dev-user now, the seed generator later).
SEED_DEFAULT_PASSWORD=change-me

# Frontend, CORS and rate limits
# The frontend's origin: redirect target after sign-in and sign-out, and the default CORS origin.
FRONTEND_URL=http://localhost:3000
# Comma-separated. Defaults to FRONTEND_URL.
# CORS_ALLOWED_ORIGINS=
# Rate limit for public endpoints, in DRF format.
PUBLIC_RATE_LIMIT=60/min

# Ports
KEYCLOAK_PORT=8080
CORE_PORT=8000
