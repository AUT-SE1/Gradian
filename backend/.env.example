# Copy to .env (`make env` does this and fills in fresh secrets) and fill in.
# Format: KEY=value, no quotes, no spaces around "=".

# Django
# development, test or production. Production refuses demo data and the test client.
ENVIRONMENT=development
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,core
LOG_LEVEL=INFO
# File loaded at startup. Defaults to the .env at the repository root.
# DOTENV_FILE=

# Database (PostgreSQL)
POSTGRES_DB=gradian
POSTGRES_USER=gradian
POSTGRES_PASSWORD=change-me
# Where the core finds the database inside the Compose network: the service name and its own port.
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Port published on 127.0.0.1 for tools on your machine. Change it if it is taken.
POSTGRES_HOST_PORT=5433

# Keycloak
# The address browsers use. It becomes Keycloak's hostname, so it is the `iss` claim of every token
# and the address of the sign-in page and the console.
KEYCLOAK_PUBLIC_URL=http://localhost:8080
# How the core and the tools reach Keycloak inside the Compose network.
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=gradian
KEYCLOAK_WEB_CLIENT_ID=gradian-web
# Tokens must carry this audience. The same client's service account calls the Admin API.
KEYCLOAK_CORE_CLIENT_ID=gradian-core
KEYCLOAK_CORE_CLIENT_SECRET=change-me
KEYCLOAK_TIMEOUT_SECONDS=5
# Keycloak's bootstrap admin, for the console at KEYCLOAK_PUBLIC_URL.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Seed data
# Password of every seeded user. The group service client secrets are derived from it too.
SEED_DEFAULT_PASSWORD=change-me

# Frontend, CORS and rate limits
# The frontend's origin: redirect target after sign-in and sign-out, and the default CORS origin.
# The Vite dev server is http://localhost:5173, the production container http://localhost:8081.
# Keycloak reads it only when it first imports the realm: after changing it, run `make reset`.
FRONTEND_URL=http://localhost:5173
# Comma-separated. Defaults to FRONTEND_URL.
# CORS_ALLOWED_ORIGINS=
# Rate limit for public endpoints, in DRF format.
PUBLIC_RATE_LIMIT=60/min
# The day of the Konkur, YYYY-MM-DD. Drives the countdown in every panel.
KONKUR_DATE=2027-06-25

# Ports
# Must match the port in KEYCLOAK_PUBLIC_URL.
KEYCLOAK_PORT=8080
CORE_PORT=8000
