# Copy to .env. Format: KEY=value, no quotes.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,team5
# Keycloak. The first is the address browsers use (the `iss` of every token), the second the one
# this container uses.
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_URL=http://keycloak:8080
# This group's client: tokens must name it in `aud`. The secret is its row in
# backend/build/credentials/services.csv (make users); needed to sign people in on this service's pages
# and to call other services.
KEYCLOAK_CLIENT_ID=group-5
KEYCLOAK_CLIENT_SECRET=
# This service as the browser reaches it (it must match the address Keycloak knows for group 5: see
# group_services in backend/seed/people.yaml), and where the panel lives.
GRADIAN_SERVICE_URL=http://localhost:8005
GRADIAN_FRONTEND_URL=http://localhost:5173
